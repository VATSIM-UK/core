  "autoload": {
    "files": [
      "app/helpers.php",
      "app/CloudflareHelper.php"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "preferred-install": "dist",
    "sort-packages": true
  },
  "description": "VATSIM UK Core Framework",
  "keywords": [
    "vatsim",
    "vatsimuk",
    "vatsim-uk",
    "vatsim uk",
    "planes",
    "aviation"
  ],
  "license": "MIT",
  "name": "vatsimuk/core",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/VATSIM-UK/public-id"
    },
    {
      "type": "vcs",
      "url": "https://github.com/VATSIM-UK/ts3phpframework"
    }
  ],
  "require": {
    "barryvdh/laravel-debugbar": "^4.4.5",
    "barryvdh/laravel-ide-helper": "^3.0",
    "bugsnag/bugsnag-laravel": "^2.31.0",
    "codewithkyrian/filament-date-range": "^2.2.1",
    "devletes/filament-progress-bar": "^1.2",
    "filament/filament": "^5.0",
    "filament/notifications": "^5.0",
    "guzzlehttp/guzzle": "^7.16.1",
    "laravel/fortify": "^1.37",
    "laravel/framework": "12.71.0",
    "laravel/helpers": "^1.1",
    "laravel/horizon": "^5.47.0",
    "laravel/passport": "^12.4.3",
    "laravel/telescope": "^5.0",
    "laravel/tinker": "^3.0",
    "laravel/ui": "^4.6.3",
    "league/csv": "^9.0",
    "league/oauth2-client": "^2.9.1",
    "livewire/livewire": "^4.4.8",
    "logtail/monolog-logtail": "^3.2",
    "maatwebsite/excel": "~4.0.6",
    "malahierba-lab/public-id": "dev-main",
    "ohdearapp/ohdear-php-sdk": "^4.7.0",
    "opcodesio/log-viewer": "^3.24.2",
    "php": "^8.4",
    "planetteamspeak/ts3-php-framework": "~1.3.0",
    "predis/predis": "^3.4",
    "pusher/pusher-php-server": "~7.3.0",
    "sentry/sentry-laravel": "^4.0",
    "spatie/calendar-links": "^2.0",
    "spatie/laravel-markdown": "^2.8.0",
    "spatie/laravel-permission": "^8.3",
    "spatie/laravel-schedule-monitor": "^4.3.3",
    "spatie/laravel-sitemap": "^8.0",
    "symfony/http-client": "^7.4.23",
    "symfony/mailgun-mailer": "^7.4.18",
    "symfony/translation": "^7.4.23",
    "team-reflex/discord-php": "^10.48",
    "watson/rememberable": "^7.1.0",
    "webbingbrasil/filament-copyactions": "^5.0",
    "whitecube/laravel-cookie-consent": "^1.3.10",
    "wohali/oauth2-discord-new": "^1.2.1"
  },
  "require-dev": {
    "brianium/paratest": "^7.17.0",
    "ext-json": "*",
    "fakerphp/faker": "^1.24.1",
    "laravel/boost": "^2.4",
    "laravel/homestead": "^15.0.3",
    "laravel/legacy-factories": "^1.4.2",
    "laravel/pint": "^1.32.2",
    "mockery/mockery": "1.6.15",
    "nunomaduro/collision": "^8.9.6",
    "phpunit/phpunit": "^12.1",
    "spatie/laravel-ignition": "^2.0",
    "spatie/laravel-ray": "^1.43.9",
    "symfony/css-selector": "^4.0",
    "symfony/dom-crawler": "^7.4.22",
    "timacdonald/log-fake": "^2.4.2"
  },
  "scripts": {
    "ide-helper": [
      "php artisan ide-helper:generate",
      "php artisan ide-helper:models -RW",
      "php artisan ide-helper:meta"
    ],
    "install-hooks": [
      "chmod +x .development/hooks/install.sh && bash .development/hooks/install.sh \"$@\""
    ],
    "lint": [
      "./vendor/bin/pint --parallel"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover",
      "@php artisan vendor:publish --force --tag=livewire:assets --ansi",
      "@php artisan filament:upgrade"
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-update-cmd": [
      "@php artisan telescope:publish",
      "@php artisan filament:upgrade"
    ]
  },
  "type": "project"
}
